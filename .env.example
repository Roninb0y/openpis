# =====================================================================
# OpenPIS-Lite 环境变量示例（仅列变量名与说明，禁止填入真实值提交）
# =====================================================================
# 使用方式：
#   1. 复制本文件为 .env（.env 已被 .gitignore 忽略），填入真实值；
#   2. docker-compose.yml 通过 ${VAR} 从 .env 读取 MySQL 口令；
#   3. 本地 java -jar 方式运行后端时，数据库密码推荐放在
#      openpis-server/application-local.yml（已被 gitignore，格式见 USAGE.md 4.6），
#      或直接设置 SPRING_DATASOURCE_PASSWORD 环境变量；
#   4. 前端变量请复制到 openpis-web/.env.development / .env.production（模板见
#      openpis-web/.env.example）。

# ---------- 后端（Spring Boot） ----------

# 后端 HTTP 端口（对应 server.port）
SERVER_PORT=8080

# 数据库 JDBC 连接串（库名建议 openpis_lite，字符集 utf8）
# 对应 spring.datasource.url
SPRING_DATASOURCE_URL=<jdbc:mysql://<host>:<port>/openpis_lite?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true>

# 数据库用户名（对应 spring.datasource.username）
SPRING_DATASOURCE_USERNAME=<你的数据库用户名>

# 数据库密码（对应 spring.datasource.password）——切勿提交真实值
SPRING_DATASOURCE_PASSWORD=<你的数据库密码>

# 上传文件存储目录，相对后端进程工作目录（对应 file.upload.path）
FILE_UPLOAD_PATH=./uploads/

# 上传文件对外访问地址前缀，须与浏览器实际访问入口一致（对应 file.access.url）
FILE_ACCESS_URL=http://localhost:8080/uploads

# JWT 签名密钥，至少 32 字节随机字符串，生产环境必须更换（对应 jwt.secret）
JWT_SECRET=<至少32字节的随机字符串>

# JWT 有效期，毫秒，默认 86400000（1 天）（对应 jwt.expiration）
JWT_EXPIRATION=86400000

# ---------- Docker Compose ----------

# MySQL 容器 root 密码（compose 中 MYSQL_ROOT_PASSWORD）
MYSQL_ROOT_PASSWORD=<MySQL root 密码>

# MySQL 容器初始化数据库名（compose 中 MYSQL_DATABASE）
MYSQL_DATABASE=openpis_lite

# ---------- 前端（Vite，见 openpis-web/.env.example） ----------

# 后端 API 地址；播放端 WebSocket 地址由它推导（http→ws 并去掉 /api）
# 生产构建建议使用相对路径 /api（由 nginx 反向代理）
VITE_API_BASE_URL=http://localhost:8080/api

# 上传文件访问地址前缀
VITE_FILE_BASE_URL=http://localhost:8080/uploads
